#!/usr/bin/env php
<?php

use GetOpt\ArgumentException;
use GetOpt\GetOpt;
use GetOpt\Option;
use gipfl\Cli\Process;
use IcingaDataNode\Application;
use IcingaDataNode\Cli;
use IcingaDataNode\Command\ConnectCommand;
use IcingaDataNode\Command\DaemonCommand;
use IcingaDataNode\Command\DbCommand;
use IcingaDataNode\Command\DisconnectCommand;
use IcingaDataNode\Command\LabCommand;
use IcingaDataNode\Command\MetricsCommand;
use IcingaDataNode\Command\ProcessLogger;
use Psr\Log\LoggerAwareInterface;
use Revolt\EventLoop;

require_once dirname(__DIR__) . '/vendor/autoload.php';
error_reporting(E_ALL | E_STRICT);

Process::setTitle(Application::PROCESS_NAME);
Cli::clearProxySettings();
EventLoop::setErrorHandler(function (Throwable $e) {
    echo $e->getMessage() . ' - ' . $e->getFile() . ':' . $e->getLine() . "\n";
    echo $e->getTraceAsString();
    exit;
});
$options = new GetOpt(null, [GetOpt::SETTING_STRICT_OPERANDS => true]);
$options->addOptions([
    Option::create('v', 'verbose')->setDescription('Enable verbose logging'),
    Option::create('d', 'debug')->setDescription('Enable debug logging')
]);
$options->addCommands([
    new ConnectCommand(),
    new DisconnectCommand(),
    new DaemonCommand(),
    new MetricsCommand(),
    new LabCommand(),
    new DbCommand(),
]);

try {
    $options->process();

    $logger = ProcessLogger::createForOptions($options);
    ProcessLogger::detectAndApplyLogWriter($logger, Application::LOG_NAME, $options);
    Application::checkRequirements($logger);

    $command = $options->getCommand();
    if (!$command) {
        echo $options->getHelpText();
        exit(1);
    }

    if ($command instanceof LoggerAwareInterface) {
        $command->setLogger($logger);
    }
    call_user_func($command->getHandler(), $options);
} catch (ArgumentException $e) {
    Cli::writeError($e->getMessage());
    echo PHP_EOL . $options->getHelpText();
    exit(1);
} catch (Throwable $e) {
    Cli::writeError($e->getMessage());
    exit(1);
}
