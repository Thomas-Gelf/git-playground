#!/usr/bin/php
<?php

use GetOpt\ArgumentException;
use GetOpt\GetOpt;
use GetOpt\Operand;
use GetOpt\Option;
use gipfl\Cli\Process;
use gipfl\Log\Writer\JsonRpcConnectionWriter;
use gipfl\Protocol\JsonRpc\JsonRpcConnection;
use gipfl\Protocol\NetString\StreamWrapper;
use gipfl\SimpleDaemon\Daemon;
use IcingaDataNode\JsonRpc\PacketHandler;
use IcingaDataNode\JsonRpc\RpcDaemonHelper;
use IcingaMetrics\ApplicationFeature;
use IcingaMetrics\Command\ProcessLogger;
use IcingaMetrics\MetricStore;
use IcingaMetrics\MetricStoreRunner;
use React\EventLoop\Loop;
use React\Stream\ReadableResourceStream;
use React\Stream\WritableResourceStream;

require_once dirname(__DIR__, 3) . '/icinga-datanode/vendor/autoload.php'; // TODO??
require_once dirname(__DIR__) . '/vendor/autoload.php';
error_reporting(E_ALL | E_STRICT);

Process::setTitle(ApplicationFeature::PROCESS_NAME . '::store[...]');
$options = new GetOpt(null, [GetOpt::SETTING_STRICT_OPERANDS => true]);
$options->addOperand(Operand::create('directory')->required());
$options->addOptions([
    Option::create('v', 'verbose')->setDescription('Enable verbose logging'),
    Option::create('d', 'debug')->setDescription('Enable debug logging')
]);

try {
    $options->process();
} catch (ArgumentException $e) {
    echo $options->getHelpText();
    exit(1);
}
$logger = ProcessLogger::createForOptions($options);
RpcDaemonHelper::logEventloopErrors($logger, 'Uncaught (metrics) error: ');

try {
    $store = new MetricStore($options->getOperand('directory'), $logger);
    $store->requireBeingConfigured();
    $handler = new PacketHandler($store->getName(), $logger);
    // $handler->registerNamespace('db', new DbRunner($this->logger, $this->loop()));
    $connection = new JsonRpcConnection(new StreamWrapper(
        new ReadableResourceStream(STDIN),
        new WritableResourceStream(STDOUT)
    ), $handler);
    $damon = new Daemon();
    $damon->setLogger($logger);
    $connection->on('close', function () use ($damon) {
        $damon->shutdown();
    });
    $logger->addWriter(new JsonRpcConnectionWriter($connection));
    Process::setTitle(ApplicationFeature::PROCESS_NAME . '::store:' . $store->getName());
} catch (Throwable $e) {
    // file_put_contents('/tmp/OOoops-' . posix_getpid(), $e->getMessage());
    echo $e->getMessage() . "\n";
    echo $e->getTraceAsString();
    exit(1);
}

try {
    RpcDaemonHelper::catchStdOut($logger);
    $runner = new MetricStoreRunner($store, $handler);
    $runner->setLogger($logger);
    $damon->attachTask($runner);
    Loop::futureTick(function () use ($damon) {
        $damon->run(Loop::get());
    });
    posix_setsid();
} catch (Throwable $e) {
    $logger->error($e->getMessage() . ' (' . $e->getFile() . ':' . $e->getLine());
    $logger->error('Shutting down in 1 second');
    // echo $e->getTraceAsString();
    Loop::addTimer(1, function () {
        Loop::stop();
        exit(1);
    });
}
Loop::run();
