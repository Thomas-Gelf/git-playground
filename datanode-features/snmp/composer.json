{
  "config": {
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "IcingaFeature\\Snmp\\": "src"
    }
  },
    "repositories": [
    {
      "type": "path",
      "url": "../../../gipfl-libs/protocol-snmp",
      "options": {
        "symlink": true
      }
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-ctype": "*",
    "ext-gmp": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-posix": "*",
    "gipfl/data-type": ">=0.3",
    "gipfl/log": ">=0.7",
    "gipfl/protocol-snmp": "@dev",
    "ramsey/uuid": "^4"
  }
}
